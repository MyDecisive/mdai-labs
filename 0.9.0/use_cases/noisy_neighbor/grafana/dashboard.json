          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Total spans evaluated by sampler",
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_processor_tail_sampling_count_traces_sampled_total[1m]))",
