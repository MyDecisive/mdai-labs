    },
    {
      "type": "timeseries",
      "title": "Dominance ratio (max-tenant / total, > 0.5 \u2192 noisy_neighbor fires)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (tenant) (db_connections_per_tenant) / on() group_left() clamp_min(sum(db_connections_per_tenant), 1)",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.4
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
