flowchart LR
  logs[Log generators]
  fluentd[Fluentd]
  gateway[OTel gateway collector]
  observer[MDAI observer]
  metrics[Service volume metrics]
  prometheus[Prometheus alerts]
  hub[MDAI Hub service_list]
  vars[mdaihub-ddf variables ConfigMap]
